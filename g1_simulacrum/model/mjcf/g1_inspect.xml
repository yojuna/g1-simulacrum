<mujoco model="g1_inspect">
  <!-- Same include pattern as g1_sensorized.xml (same directory as g1_robot.xml
       so compiler meshdir=assets still resolves). Extra boxes give Mid-360
       and D435i something to hit besides the floor. -->
  <include file="g1_robot.xml"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>
  <statistic center="0.6 0 0.8" extent="2.5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/>
    <scale frustum="0.2"/>
  </visual>
  <worldbody>
    <light name="top_light" pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.82 0.82 0.82 1"/>
    <geom name="box_red" type="box" pos="1.8 0 0.25" size="0.12 0.2 0.25"
          rgba="0.85 0.22 0.15 1"/>
    <geom name="box_green" type="box" pos="2.2 0.9 0.2" size="0.15 0.15 0.2"
          rgba="0.2 0.7 0.25 1"/>
    <geom name="box_blue" type="box" pos="1.5 -1.1 0.4" size="0.18 0.12 0.4"
          rgba="0.2 0.35 0.85 1"/>
    <geom name="box_yellow" type="box" pos="0.35 1.6 0.15" size="0.2 0.2 0.15"
          rgba="0.9 0.8 0.15 1"/>
  </worldbody>
</mujoco>
